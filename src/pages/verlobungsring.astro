---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import RatingBadge from '../components/RatingBadge.astro';
import ServiceColumns from '../components/ServiceColumns.astro';
import FeatureCards from '../components/FeatureCards.astro';
import SplitFeature from '../components/SplitFeature.astro';
import TextColumns from '../components/TextColumns.astro';
import SeoTextColumns from '../components/SeoTextColumns.astro';
import Reviews from '../components/Reviews.astro';
import RingSlider from '../components/RingSlider.astro';

const steps = [
  {
    icon: 'fassung',
    title: 'Fassung und Stil',
    text: 'Klassischer Solitär, Ring mit Seitensteinen oder ein zurückhaltendes, modernes Design – wir zeigen Ihnen, was zu Ihrer Partnerin oder Ihrem Partner passt.',
  },
  {
    icon: 'metall',
    title: 'Edelmetall',
    text: 'Gelbgold, Weißgold, Roségold oder Platin. Die Wahl hängt vom Hautton, vom Schmuck, der bereits getragen wird, und von Ihrem Geschmack ab.',
  },
  {
    icon: 'diamant',
    title: 'Diamant oder Edelstein',
    text: 'Beurteilt werden Schliff, Reinheit, Farbe und Karatgewicht. Wir erklären Ihnen die Unterschiede verständlich und helfen Ihnen, ein gutes Verhältnis zwischen Wirkung und Preis zu finden.',
  },
  {
    icon: 'groesse',
    title: 'Ringgröße',
    text: 'Sie kennen die Größe nicht, wollen aber nichts verraten? Wir geben Ihnen Tipps, wie Sie sie unauffällig herausfinden. Falls der Ring nicht passt, können wir ihn in der Regel anpassen.',
  },
];

const columns = [
  {
    image: '/assets/img/verlobungsring-haende-paar-bingen.webp',
    alt: 'Paar hält sich an den Händen, sie trägt einen Solitär-Verlobungsring, Verlobungsringe vom Juwelier Fein in Bingen',
    title: 'Verlobungsring und Trauringe',
    paragraphs: [
      'Wenn aus der Verlobung eine Hochzeit wird, begleiten wir Sie auch bei der Wahl Ihrer Eheringe. Entdecken Sie unsere <a href="/produkte/ringe">Trauringe</a> oder gestalten Sie Ihre Ringe direkt im <a href="/trauringkonfigurator">Trauringkonfigurator</a>. So passen Verlobungsring und Trauring später perfekt zusammen.',
    ],
  },
  {
    image: '/assets/img/heiratsantrag-verlobungsring-bingen.webp',
    alt: 'Heiratsantrag mit Verlobungsring, Verlobungsringe vom Juwelier Fein in Bingen',
    title: 'Beratungstermin vereinbaren',
    paragraphs: [
      'Kommen Sie einfach in unserem Geschäft in der Basilikastraße 30 in Bingen am Rhein vorbei oder <a href="/kontakt">vereinbaren Sie online einen Termin</a>. Wir freuen uns darauf, gemeinsam mit Ihnen den passenden Verlobungsring zu finden.',
      'Ihr Team des <a href="/">Juwelier Fein in Bingen</a>.',
    ],
  },
];

const seoColumns = [
  {
    blocks: [
      {
        title: 'Verlobungsring kaufen in Bingen',
        paragraphs: [
          'Sie suchen einen Verlobungsring in Bingen? Bei Juwelier Fein in der Basilikastraße 30 finden Sie Ringe für den schönsten Antrag, von klassisch bis modern. Seit fast 140 Jahren steht unser Haus für persönliche Beratung und gutes Handwerk, und wir führen diese Tradition im gleichen Sinne weiter.',
          'Ein Verlobungsring ist mehr als Schmuck: Er begleitet Sie ein Leben lang. Deshalb nehmen wir uns Zeit, hören zu und zeigen Ihnen Ringe, die zu Ihrer Partnerin oder Ihrem Partner, zum Alltag und zu Ihrem Budget passen. Ob Solitärring mit einem einzelnen Diamanten, Ring mit Seitensteinen oder ein Modell mit farbigem Edelstein, wir beraten Sie ehrlich und ohne Kaufdruck.',
        ],
      },
      {
        title: 'Verlobungsring und Trauring: der Unterschied',
        paragraphs: [
          'Der Verlobungsring wird traditionell beim Heiratsantrag überreicht, der Trauring beim Ja-Wort. Viele Paare tragen den Verlobungsring nach der Hochzeit zusammen mit dem Ehering weiter. Damit beide Ringe harmonisch zusammenwirken, beraten wir Sie gerne zu beidem. Mehr dazu finden Sie bei unseren <a href="/produkte/ringe">Trauringen</a> und im <a href="/trauringkonfigurator">Trauringkonfigurator</a>.',
        ],
      },
    ],
  },
  {
    blocks: [
      {
        title: 'Ringgröße bestimmen und Ring anpassen',
        paragraphs: [
          'Die richtige Ringgröße ist wichtig, damit der Ring bequem sitzt. Wenn der Antrag eine Überraschung bleiben soll, hilft oft ein Ring, den Ihre Partnerin oder Ihr Partner bereits trägt. Wir messen ihn genau aus. Sitzt der Verlobungsring nach dem Antrag nicht perfekt, kann er in der Regel angepasst werden. Auch Reparaturen und Gravuren erledigen wir für Sie.',
        ],
      },
      {
        title: 'Gold, Platin und Diamanten',
        paragraphs: [
          'Verlobungsringe gibt es in Gelbgold, Weißgold, Roségold und Platin. Bei Diamanten und Edelsteinen sind Schliff, Reinheit, Farbe und Karatgewicht die entscheidenden Merkmale. Wir erklären Ihnen diese Kriterien verständlich und zeigen Ihnen am Stück, worauf es ankommt.',
        ],
      },
      {
        title: 'Verlobungsringe für Bingen und die Region',
        paragraphs: [
          'Unser Geschäft liegt in der Basilikastraße, ganz in der Nähe der Burg Klopp. Rund um das Geschäft sind viele Parkplätze verfügbar. Gäste aus Ingelheim, Rüdesheim, Bad Kreuznach, Mainz und Wiesbaden sind uns genauso willkommen wie Paare aus Bingen. <a href="/kontakt">Vereinbaren Sie jetzt Ihren Beratungstermin</a>, wir freuen uns auf Sie.',
        ],
      },
    ],
  },
];
---
<Base
  title="Verlobungsring in Bingen kaufen - Juwelier Fein"
  description="Verlobungsringe in Bingen am Rhein: Persönliche Beratung zu Diamantringen, Fassungen und Größe bei Juwelier Fein in der Basilikastraße."
>
  <PageHero
    kicker="Verlobungsringe in Bingen &ndash; persönlich &amp; individuell"
    title="Verlobungsring in Bingen"
    text="Der Antrag ist einer der schönsten Momente im Leben, und der Verlobungsring macht ihn unvergesslich. Bei Juwelier Fein nehmen wir uns Zeit für Sie, zeigen Ihnen verschiedene Modelle und beantworten alle Ihre Fragen &ndash; ohne Kaufdruck."
    buttonLabel="Termin vereinbaren"
    buttonHref="/kontakt"
    image="/assets/img/verlobungsring-antrag-ring-anstecken-bingen.webp"
    imageLabel="Verlobungsring wird bei der Trauung angesteckt, Verlobungsringe vom Juwelier Fein in Bingen"
    slides={[
      '/assets/img/verlobungsring-solitaer-gelbgold-satin-bingen.webp',
      '/assets/img/verlobungsring-antrag-ring-anstecken-bingen.webp',
      '/assets/img/verlobungsring-solitaer-rosegold-bingen.webp',
    ]}
  >
    <RatingBadge />
  </PageHero>

  <RingSlider
    set="verlobungsringe"
    title="Verlobungsringe in Gold, Weißgold & Roségold"
  />

  <ServiceColumns tinted />

  <FeatureCards
    titleBefore="Was beim Kauf eines"
    titleHighlight="Verlobungsrings"
    titleAfter="wichtig ist"
    intro="Vier Punkte, an denen Sie sich orientieren können. Zu jedem einzelnen beraten wir Sie gerne persönlich in unserem Geschäft in Bingen."
    items={steps}
  />

  <SplitFeature
    kicker="Individuell &amp; persönlich"
    title="Individuelle Wünsche"
    text="Sie haben eine besondere Idee, möchten einen vorhandenen Stein neu fassen lassen oder wünschen eine persönliche Gravur? Sprechen Sie uns an. Gerne besprechen wir mit Ihnen, was möglich ist. Auch bei Schmuck und Uhren steht Ihnen unser Reparatur-Service zur Seite."
    image="/assets/img/verlobungsring-etui-juwelier-fein-bingen.webp"
    alt="Solitär-Verlobungsring im schwarzen Etui von Juwelier Fein, umgeben von Blumen"
    imagePosition="center 70%"
    imageNote="KI-generiertes Bild"
    linkLabel="Beratungstermin vereinbaren"
    linkHref="/kontakt"
  />

  <TextColumns items={columns} />

  <SeoTextColumns columns={seoColumns} />

  <Reviews />
</Base>

---
// Seiten-Hero: Titelblock links (mit goldener Linie), Bild rechts, optional Inhalt unter dem Bild (Slot)
const {
  kicker,
  title,
  text,
  buttonLabel,
  buttonHref = '/kontakt',
  image,
  imageLabel = '',
  slides = [],
  divider = true,
} = Astro.props;
---
<section id="hero_outer" class="page-hero">
  <div class="hero-media">
    <section
      id="hero"
      class="blank"
      data-slides={slides.length ? slides.join(',') : undefined}
      role="img"
      aria-label={imageLabel}
      style={`background-image: url(${image})`}
    >
      <div class="content"></div>
    </section>
    <slot />
  </div>

  <section id="hero_content" class="blank">
    {kicker && <span class="kicker" set:html={kicker} />}
    <h1>{title}</h1>
    <p set:html={text} />
    {buttonLabel && (
      <a href={buttonHref}>
        <button>{buttonLabel}</button>
      </a>
    )}
  </section>
</section>
{divider && <div class="hero-divider" role="presentation"></div>}

<style>
  /* feiner goldener Trennstrich unter dem Hero */
  .hero-divider {
    width: min(1100px, 90%);
    height: 1px;
    margin: 0 auto;
    background: linear-gradient(to right, transparent, #d8c29d 20%, #d8c29d 80%, transparent);
  }
  #hero_outer.page-hero {
    margin-bottom: 56px;
  }
  .hero-media {
    flex: 0 1 100%;
    min-width: 0;
    width: 100%;
  }
  .kicker {
    display: block;
    color: #b89b63;
    font-size: 16px;
    margin-bottom: 14px;
  }
</style>

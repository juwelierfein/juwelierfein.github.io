---
// Zwei Textspalten für längeren SEO-Text (Überschriften + Absätze, HTML erlaubt), optional mit Hauptüberschrift
// columns: [{ blocks: [{ title, paragraphs: string[] }] }]
const { heading, columns } = Astro.props;
---
<section class="seo-text">
  {heading && <h2>{heading}</h2>}
  <div class="seo-grid">
    {columns.map((col) => (
      <div class="seo-col">
        {col.blocks.map((block) => (
          <>
            <h3>{block.title}</h3>
            {block.paragraphs.map((html) => <p set:html={html} />)}
          </>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .seo-text {
    width: 1100px;
    max-width: 90%;
    margin: 72px auto;
  }
  .seo-text h2 {
    margin: 0 0 32px;
  }
  .seo-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 64px;
  }
  .seo-col h3 {
    margin: 32px 0 12px;
    font-size: 24px;
    line-height: 1.3;
  }
  .seo-col h3:first-child {
    margin-top: 0;
  }
  .seo-col p {
    margin: 0 0 16px;
    font-size: 17px;
    line-height: 1.7;
  }
  .seo-col :global(a),
  .seo-col :global(a:visited) {
    color: #d8c29d;
  }
  .seo-col :global(a:hover) {
    color: #b89b63;
  }
  @media (min-width: 800px) {
    .seo-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

---
// Bild links (bündig), Text auf heller Fläche rechts
const { kicker, title, text, image, alt = '', linkLabel, linkHref = '/kontakt', imagePosition = 'center', imageNote = '' } = Astro.props;
---
<section class="split">
  <div class="split-img">
    <img src={image} alt={alt} width="1200" height="675" loading="lazy" style={`object-position: ${imagePosition}`} />
    {imageNote && <span class="img-note">{imageNote}</span>}
  </div>
  <div class="split-text">
    {kicker && <span class="kicker" set:html={kicker} />}
    <h2>{title}</h2>
    <p set:html={text} />
    {linkLabel && <a class="link" href={linkHref}>{linkLabel} &rarr;</a>}
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr;
    margin: 56px 0;
    background: #f4f2ee;
  }
  .split-img {
    position: relative;
  }
  .img-note {
    position: absolute;
    right: 8px;
    bottom: 8px;
    padding: 2px 6px;
    font-size: 11px;
    line-height: 1.4;
    color: #fff;
    background: rgba(0, 0, 0, 0.45);
    pointer-events: none;
  }
  .split-img img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
  }
  .split-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 48px 8%;
  }
  .kicker {
    color: #b89b63;
    font-size: 14px;
    letter-spacing: 0.04rem;
    margin-bottom: 14px;
  }
  .split-text h2 {
    font-size: clamp(30px, 3.4vw, 46px);
    line-height: 1.15;
    margin: 0 0 22px;
  }
  .split-text p {
    line-height: 1.75;
    margin: 0 0 28px;
  }
  .link {
    align-self: flex-start;
    color: #2b3744;
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 1px solid #d8c29d;
  }
  .link:hover {
    color: #b89b63;
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: 1fr 1fr;
      min-height: 440px;
    }
    .split-text {
      padding: 48px 7%;
    }
  }
</style>
